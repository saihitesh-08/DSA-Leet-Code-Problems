class Solution {
    public int countGoodNumbers(long n) {
        long mod = 1000000007;

        long even = (n + 1) / 2;
        long odd = n / 2;

        long a = power(5, even, mod);
        long b = power(4, odd, mod);

        return (int)((a * b) % mod);
    }

    public long power(long x, long n, long mod) {
        long result = 1;

        while (n > 0) {
            if (n % 2 == 1) {
                result = (result * x) % mod;
            }

            x = (x * x) % mod;
            n = n / 2;
        }

        return result;
    }
}
