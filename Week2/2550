
class Solution {
    public int monkeyMove(int n) {
        long mod = 1000000007;
        long result = 1;
        long base = 2;
        while(n > 0) {

            if(n % 2 == 1) {
                result = (result * base) % mod;
            }

            base = (base * base) % mod;
            n = n / 2;
        }

        result = (result - 2 + mod) % mod;

        return (int) result;
    }
}
